# Postgres (Neon / Netlify DB) — used by all core CRM modules
DATABASE_URL=

# SQL Server (iRx) — GLP1 program data source (dbo.ReadyToAssign)
SQLSERVER_HOST=74.117.224.152
SQLSERVER_PORT=1433
SQLSERVER_DB=iRx
SQLSERVER_USER=claudeservices
SQLSERVER_PASSWORD=

# Client SFTP imports (scripts/client_imports/) — one password env var per client feed
IRX_DB_PWD=            # SQL Server 'claudeservices' password (same value as SQLSERVER_PASSWORD)
MCR_SFTP_PWD=          # MCR Hotels SFTP password (us-east-1.sftpcloud.io, user 'MANAGER')

# Reconciliation email (scripts/client_imports/reconcile.py --send) — Microsoft 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=onbasesupport@internationalrx.com
SMTP_PASS=
MAIL_FROM=onbasesupport@internationalrx.com

# SMS via Azure Communication Services (netlify/functions/_sms.js, sms.js, sms-events.js)
# The SMS module is inert until BOTH ACS_CONNECTION_STRING and SMS_FROM are set —
# there is no separate enable flag; setting them activates live sending.
ACS_CONNECTION_STRING=   # ACS resource (acs-tpcrm-sms) connection string — "endpoint=https://...;accesskey=..."
SMS_FROM=+18665617622    # verified toll-free sender (E.164)
SMS_EVENTS_KEY=          # shared secret in the Event Grid delivery-report webhook URL:
                         #   https://<site>/.netlify/functions/sms-events?key=<SMS_EVENTS_KEY>
# Watcher job only (scripts/sms_verify_watch.py, PIPELINE=smswatch): WATCH_TO, WATCH_EMAIL
